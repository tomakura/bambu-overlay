{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bambu Overlay",
  "version": "1.0.0",
  "identifier": "dev.flow.bambu-overlay",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bambu Overlay",
        "label": "main",
        "width": 430,
        "height": 440,
        "minWidth": 360,
        "minHeight": 130,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
